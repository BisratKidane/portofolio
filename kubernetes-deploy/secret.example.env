# Copy to `secret.env` (gitignored), fill in REAL values. deploy.sh turns this
# into the `portofolio-secret` Secret via `kubectl create secret --from-env-file`.
#
#   cp secret.example.env secret.env
#   $EDITOR secret.env
#
# DB_PASSWORD and MYSQL_PASSWORD MUST match (same DB account).
JWT_SECRET=CHANGE_ME_use_a_long_random_string
DB_PASSWORD=CHANGE_ME_db_password
MYSQL_PASSWORD=CHANGE_ME_db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
# SMTP credentials (required for NODE_ENV=production).
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
