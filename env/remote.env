NODE_ENV=production
COMPOSE_ENV_FILE=env/remote.env
PORT=4000
CLIENT_PORT=3000
CLIENT_URL=https://example.com
CLIENT_ORIGINS=https://example.com
VITE_API_URL=/graphql
VITE_PROXY_TARGET=http://backend:4000
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRES_IN=1d
RESET_TOKEN_EXPIRES_MINUTES=30
DB_HOST=mysql
DB_PORT=3306
DB_NAME=portofolio
DB_USER=portofolio
DB_PASSWORD=replace-me
MYSQL_DATABASE=portofolio
MYSQL_USER=portofolio
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me-root
