NODE_ENV=development
COMPOSE_ENV_FILE=env/local.container.env
PORT=4040
CLIENT_PORT=5173
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=/graphql
VITE_PROXY_TARGET=http://localhost:4040
JWT_SECRET=change-me-local-jwt-secret
JWT_EXPIRES_IN=1d
RESET_TOKEN_EXPIRES_MINUTES=30
MAX_QUERY_DEPTH=12
# Email (Resend). Set RESEND_API_KEY to send real verification/reset emails
# from local too — host/user default to Resend automatically. Leave it unset to
# keep the no-op transport that just logs the link ([mailer] ...) to the console.
# SMTP_FROM must be a Resend-verified domain (or use onboarding@resend.dev to
# test to your own address). SMTP_REPLY_TO is optional (replies reach a real inbox).
# RESEND_API_KEY=re_your_key_here
# SMTP_FROM="Portofolio <noreply@yourdomain.ch>"
# SMTP_REPLY_TO=you@gmail.com
#
# To use a different provider instead of Resend, set these explicitly:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portofolio
DB_USER=portofolio
DB_PASSWORD=portofolio
MYSQL_DATABASE=portofolio
MYSQL_USER=portofolio
MYSQL_PASSWORD=portofolio
MYSQL_ROOT_PASSWORD=ServeMySql2009Secure

