NODE_ENV=development
COMPOSE_ENV_FILE=env/local.container.env
PORT=4000
CLIENT_PORT=5173
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=/graphql
VITE_PROXY_TARGET=http://localhost:4000
JWT_SECRET=change-me-local-jwt-secret
JWT_EXPIRES_IN=1d
RESET_TOKEN_EXPIRES_MINUTES=30
MAX_QUERY_DEPTH=12
# SMTP is only used when NODE_ENV=production. In development the mailer uses a
# no-op transport and logs the reset link instead, so these stay unset.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portofolio
DB_USER=portofolio
DB_PASSWORD=portofolio
MYSQL_DATABASE=portofolio
MYSQL_USER=portofolio
MYSQL_PASSWORD=portofolio
MYSQL_ROOT_PASSWORD=portofolio_root
