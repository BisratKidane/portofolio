# Local secret overrides — copy to `env/local.secrets.env` (gitignored) and fill in.
# These override the placeholders in env/local.env when you run the backend with
# BOTH env files, so a real API key never lives in a git-tracked file:
#
#   docker compose --env-file env/local.env --env-file env/local.secrets.env up -d --build backend
#
# Leaving env/local.secrets.env absent is fine — the mailer just logs the link
# ([mailer] ...) instead of sending (jsonTransport fallback).

# Resend API key (dashboard -> API Keys). Alone, it defaults host=smtp.resend.com, user=resend.
RESEND_API_KEY=re_your_key_here
# Sender. Use onboarding@resend.dev to test to your own Resend account email,
# or a Resend-verified domain to email anyone.
SMTP_FROM="Portofolio <onboarding@resend.dev>"
# Optional: replies go here even though From is a no-reply/verified address.
SMTP_REPLY_TO=you@example.com
