NODE_ENV=test
PORT=4000
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=change-me-local-jwt-secret
JWT_EXPIRES_IN=1d
RESET_TOKEN_EXPIRES_MINUTES=30
# The account whose verified email exactly matches this value is promoted to
# ADMIN by verifyEmail's zero-admin bootstrap (CR-01). Leaving it empty means
# no automatic promotion ever occurs. Read once at boot by backend/src/config/env.js.
ADMIN_EMAIL=
MAX_QUERY_DEPTH=12
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portofolio_test
DB_USER=portofolio
DB_PASSWORD=portofolio
