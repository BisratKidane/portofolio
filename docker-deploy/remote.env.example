# Production runtime env — copy to `remote.env`, fill in REAL values, keep it secret.
# `remote.env` is gitignored. It is shipped to the server by deploy.sh and used
# both for docker compose variable interpolation and as the backend container env.
#
#   cp remote.env.example remote.env
#   $EDITOR remote.env
#
# NOTE: the image tags below are overridden by deploy.sh at deploy time with the
# exact images it just built/pushed (immutable git-sha tag). They only matter if
# you run `docker compose` on the server by hand.
IMAGE_BACKEND=docker.io/your-dockerhub-username/portofolio-backend:latest
IMAGE_FRONTEND=docker.io/your-dockerhub-username/portofolio-frontend:latest

# Public domain (Caddy issues a Let's Encrypt cert for this host).
DOMAIN=app.example.com

# ---- App runtime ----
NODE_ENV=production
PORT=4000
CLIENT_URL=https://app.example.com
CLIENT_ORIGINS=https://app.example.com
JWT_SECRET=CHANGE_ME_use_a_long_random_string
JWT_EXPIRES_IN=1d
RESET_TOKEN_EXPIRES_MINUTES=30

# ---- SMTP (REQUIRED when NODE_ENV=production — the backend refuses to boot without it) ----
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=no-reply@app.example.com

# ---- Database ----
# DB_PASSWORD and MYSQL_PASSWORD MUST be identical (same account).
DB_HOST=mysql
DB_PORT=3306
DB_NAME=portofolio
DB_USER=portofolio
DB_PASSWORD=CHANGE_ME_db_password
MYSQL_DATABASE=portofolio
MYSQL_USER=portofolio
MYSQL_PASSWORD=CHANGE_ME_db_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
