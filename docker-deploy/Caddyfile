# Caddy edge proxy. {$DOMAIN} is read from the container environment.
# Caddy automatically obtains + renews a Let's Encrypt certificate for the
# domain (needs public ports 80 + 443 and a DNS A record pointing here).
{$DOMAIN} {
	encode gzip

	# API -> backend. Paths are preserved. /graphql is the GraphQL endpoint;
	# /api/* covers the non-GraphQL photo routes (upload/serve/delete) mounted at
	# app.use('/api', photoRouter) — these MUST be proxied or photo upload and
	# avatar image loading 404 against the static SPA.
	@backend path /graphql /graphql/* /api /api/*
	handle @backend {
		reverse_proxy backend:4000
	}

	# Everything else -> static SPA.
	handle {
		reverse_proxy frontend:80
	}
}
